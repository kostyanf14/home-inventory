# Local development defaults. Copy to .env and adjust.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./home_inventory.db

# Required when ENVIRONMENT=production (at least 32 characters, unique per deployment).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
